rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // token.get(..., false) rather than `token.admin == true`: a missing
    // claim (every non-admin caller) resolves to `false` cleanly instead of
    // throwing an EvaluationException on the direct property access — only
    // absorbed into `false` by CEL's `||` short-circuiting today, which
    // silently floods the rules-evaluation logs for every non-admin read.
    // Mirrors storage.rules' isAdmin() already.
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function isMember(profileId) {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(profileId)/members/$(request.auth.uid));
    }
    function profileApproved(profileId) {
      return get(/databases/$(database)/documents/profiles/$(profileId)).data.status == 'approved';
    }
    // "This uid currently belongs to >=1 approved curator profile." A
    // presence-only marker (contents never read) maintained by Cloud
    // Functions on curator approval/unpublish and membership changes
    // (Task 4's approval path + Task 6's cascade) — a custom claim can't be
    // kept in sync with profile-approval state without a token refresh,
    // while a lookup doc updates instantly.
    function isApprovedCuratorMember() {
      return signedIn() && exists(/databases/$(database)/documents/curatorAccess/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Created by Cloud Functions; owner may update editable fields only,
      // and only to well-typed, size-bounded values. Fields absent from the
      // resulting document are read via .get(key, default) — direct property
      // access on a missing map key throws during rule evaluation, which
      // would otherwise break an update that doesn't touch every field.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoUrl', 'homeCity'])
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('displayName', '').size() <= 80
        && (request.resource.data.get('photoUrl', null) == null
            || (request.resource.data.get('photoUrl', null) is string
                && request.resource.data.get('photoUrl', null).matches('^https://.*')
                && request.resource.data.get('photoUrl', null).size() <= 500))
        && (request.resource.data.get('homeCity', null) == null
            || (request.resource.data.get('homeCity', null) is string
                && request.resource.data.get('homeCity', null).size() <= 80));
      allow create, delete: if false;

      match /notifications/{noteId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
      match /pushTokens/{tokenId} {
        allow read: if isOwner(uid);
        // Doc id must be a well-formed Expo push token, and the payload may
        // only ever contain createdAt (matches push.ts's write shape) —
        // otherwise a client could write arbitrary token ids/fields into a
        // collection a Cloud Function later fans push notifications out to.
        allow write: if isOwner(uid)
          && tokenId.matches('^ExponentPushToken\\[[A-Za-z0-9_-]+\\]$')
          && request.resource.data.keys().hasOnly(['createdAt']);
      }
    }

    match /profiles/{profileId} {
      allow read: if resource.data.status == 'approved' || isMember(profileId) || isAdmin();
      allow write: if false; // Cloud Functions only

      match /members/{memberUid} {
        // self-read clause serves the collection-group "my profiles" query.
        // Ordered read-free/cheap checks first — profileApproved() is a
        // billed get() — so the common non-admin, non-approved-profile
        // paths short-circuit before paying for it.
        allow get: if isAdmin() || isMember(profileId)
          || (signedIn() && request.auth.uid == resource.data.uid) || profileApproved(profileId);
        // Listing the whole roster is narrower than a single get — an
        // unauthenticated/non-member caller could otherwise page through
        // every member of even an approved profile via a collection list.
        allow list: if isMember(profileId) || isAdmin();
        allow write: if false; // Cloud Functions only
      }

      match /tracks/{trackId} {
        // Public track reads require BOTH the profile and the track approved.
        // List queries must filter status == 'approved' (unfiltered lists fail),
        // which keeps pending/rejected titles out of public reach.
        // Read-free checks first — profileApproved() is a billed get() — so
        // member/admin reads short-circuit before paying for it.
        allow read: if isAdmin() || isMember(profileId)
          || (profileApproved(profileId) && resource.data.status == 'approved');
        allow write: if false; // Cloud Functions only
      }

      match /private/booking {
        // Rates/preferences: never public. Sub-project 3 widens this to
        // members of approved curator profiles, via the curatorAccess/{uid}
        // marker (see isApprovedCuratorMember() above) rather than this
        // profile's own membership — a curator shopping for acts needs to
        // see ANY profile's rates, not just the ones they belong to.
        allow read: if isMember(profileId) || isAdmin() || isApprovedCuratorMember();
        allow write: if false; // Cloud Functions only
      }
    }

    // ---------- Sub-project 3: gigs, series, curator admin notes ----------
    match /gigs/{gigId} {
      // Only callables write, and only approved curator profiles can post;
      // profile unpublish cascades close open gigs (review.ts), so a bare
      // status check is sufficient — no per-read profile get().
      // List queries MUST filter status == 'open' (unfiltered lists fail).
      // Member/admin disjuncts are also list-provable as written: a curator
      // dashboard query filtered by where('curatorProfileId','==',X) pins
      // that field to a query-wide constant, so isMember(X) evaluates once
      // (not per document) — if true, that disjunct alone proves the whole
      // OR for every possible result, regardless of each doc's actual
      // (unconstrained) status. isAdmin() never depends on resource.data,
      // so it's provable for any query, filtered or not.
      allow read: if resource.data.status == 'open'
        || isAdmin() || isMember(resource.data.curatorProfileId);
      allow write: if false;
      match /private/location {
        // booked musician joins in sub-4
        allow read: if isAdmin()
          || isMember(get(/databases/$(database)/documents/gigs/$(gigId)).data.curatorProfileId);
        allow write: if false;
      }
    }
    match /gigSeries/{seriesId} {
      // Same list-provability shape as gigs above; series has no public
      // disjunct (never publicly listed), so an unfiltered or stranger list
      // always fails — only a curatorProfileId-filtered member query or an
      // admin's (filtered or not) query is provable.
      allow read: if isAdmin() || isMember(resource.data.curatorProfileId);
      allow write: if false;
    }
    match /adminNotes/{uid} { allow read: if isAdmin(); allow write: if false; }
    match /curatorAccess/{uid} { allow read: if isOwner(uid) || isAdmin(); allow write: if false; }

    // Recursive-wildcard match needed for collectionGroup('members') queries —
    // the nested /profiles/{profileId}/members/{memberUid} rule above does NOT
    // apply to collection-group queries. Mirrors the self-read clause so the
    // app's "my profiles" query (collectionGroup('members').where('uid','==',uid))
    // works for signed-in users reading their own membership docs. Also grants
    // admins the same collection-group access the nested rule's get already
    // gives them, so the admin dashboard's per-user "profiles and statuses"
    // lookup (collectionGroup('members').where('uid','==', targetUid)) works.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // Admin review queue: collectionGroup('tracks').where('status','==','pending_review').
    // The nested tracks rule above does not apply to collection-group queries.
    match /{path=**}/tracks/{trackId} {
      allow read: if isAdmin();
    }

    match /invites/{inviteId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.invitedUid
            || request.auth.uid == resource.data.invitedByUid);
      allow write: if false; // Cloud Functions only
    }

    // Listing this collection would dump every handle (including
    // draft/rejected profiles' handles) to any unauthenticated caller; a
    // single get() by known handle (the public profile page's lookup path)
    // stays world-readable.
    match /handles/{handle}   { allow get: if true; allow list: if false; allow write: if false; }
    match /auditLogs/{logId}  { allow read: if isAdmin(); allow write: if false; }
    match /{document=**}      { allow read, write: if false; }
  }
}
