rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // token.get(..., false) rather than `token.admin == true`: a missing
    // claim (every non-admin caller) resolves to `false` cleanly instead of
    // throwing an EvaluationException on the direct property access, only
    // absorbed into `false` by CEL's `||` short-circuiting today, which
    // silently floods the rules-evaluation logs for every non-admin read.
    // Mirrors storage.rules' isAdmin() already.
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function isMember(profileId) {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(profileId)/members/$(request.auth.uid));
    }
    function profileApproved(profileId) {
      return get(/databases/$(database)/documents/profiles/$(profileId)).data.status == 'approved';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Created by Cloud Functions; owner may update editable fields only,
      // and only to well-typed, size-bounded values. Fields absent from the
      // resulting document are read via .get(key, default), direct property
      // access on a missing map key throws during rule evaluation, which
      // would otherwise break an update that doesn't touch every field.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoUrl', 'homeCity'])
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('displayName', '').size() <= 80
        && (request.resource.data.get('photoUrl', null) == null
            || (request.resource.data.get('photoUrl', null) is string
                && request.resource.data.get('photoUrl', null).matches('^https://.*')
                && request.resource.data.get('photoUrl', null).size() <= 500))
        && (request.resource.data.get('homeCity', null) == null
            || (request.resource.data.get('homeCity', null) is string
                && request.resource.data.get('homeCity', null).size() <= 80));
      allow create, delete: if false;

      match /notifications/{noteId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
      match /pushTokens/{tokenId} {
        allow read: if isOwner(uid);
        // Doc id must be a well-formed Expo push token, and the payload may
        // only ever contain createdAt (matches push.ts's write shape),
        // otherwise a client could write arbitrary token ids/fields into a
        // collection a Cloud Function later fans push notifications out to.
        allow write: if isOwner(uid)
          && tokenId.matches('^ExponentPushToken\\[[A-Za-z0-9_-]+\\]$')
          && request.resource.data.keys().hasOnly(['createdAt']);
      }
    }

    match /profiles/{profileId} {
      allow read: if resource.data.status == 'approved' || isMember(profileId) || isAdmin();
      allow write: if false; // Cloud Functions only

      match /members/{memberUid} {
        // self-read clause serves the collection-group "my profiles" query.
        // Ordered read-free/cheap checks first, profileApproved() is a
        // billed get(), so the common non-admin, non-approved-profile
        // paths short-circuit before paying for it.
        allow get: if isAdmin() || isMember(profileId)
          || (signedIn() && request.auth.uid == resource.data.uid) || profileApproved(profileId);
        // Listing the whole roster is narrower than a single get, an
        // unauthenticated/non-member caller could otherwise page through
        // every member of even an approved profile via a collection list.
        allow list: if isMember(profileId) || isAdmin();
        allow write: if false; // Cloud Functions only
      }

      match /tracks/{trackId} {
        // Public track reads require BOTH the profile and the track approved.
        // List queries must filter status == 'approved' (unfiltered lists fail),
        // which keeps pending/rejected titles out of public reach.
        // Read-free checks first, profileApproved() is a billed get(), so
        // member/admin reads short-circuit before paying for it.
        allow read: if isAdmin() || isMember(profileId)
          || (profileApproved(profileId) && resource.data.status == 'approved');
        allow write: if false; // Cloud Functions only
      }

      match /private/booking {
        // Rates/preferences: never public, and, TIGHTEN (spec §6 / M-13
        // resolution), no longer curator-shopping-readable either. Sub-3's
        // isApprovedCuratorMember() disjunct is removed: this is the raw
        // source doc now, member/admin only. Curators shopping for acts read
        // the server-built curatorBooking projection below instead.
        allow read: if isMember(profileId) || isAdmin();
        allow write: if false; // Cloud Functions only
      }

      match /private/stripe {
        // Payment identity + cached gate flags: members + admins only, same
        // audience as private/booking. Server-write only.
        allow read: if isMember(profileId) || isAdmin();
        allow write: if false; // Cloud Functions only
      }

      match /private/curatorBooking {
        // SP4: server-built projection (bookingVisibility.ts's
        // rebuildBookingProjections), rates with "private"-visibility
        // structures nulled out, full preferences, and a reliability
        // summary. This is now the curator-shopping surface the old
        // isApprovedCuratorMember() disjunct granted on private/booking
        // above: any signed-in member of >=1 approved curator profile,
        // via the curatorAccess/{uid} presence-only marker (maintained by
        // Cloud Functions on curator approval/unpublish and membership
        // changes, a custom claim can't stay in sync without a token
        // refresh, while a lookup doc updates instantly), may read ANY
        // profile's projection. isAdmin() ordered before the exists() check
        // per the file's cost idiom (SP3 Task 14), free for admins.
        // signedIn() guard: request.auth.uid on an anon caller resolves to
        // null, which throws an EvaluationException inside the exists()
        // path-building rather than absorbing into `false`, the same
        // anon-eval-error flood isAdmin() (line ~13) was deliberately
        // engineered out of; guard it here too.
        allow read: if isAdmin() || isMember(profileId)
          || (signedIn() && exists(/databases/$(database)/documents/curatorAccess/$(request.auth.uid)));
        allow write: if false; // Cloud Functions only
      }

      match /private/reliability {
        // No-show marks + completedCount: member (own record) + admin only,
        // never curator-shopping-readable, curatorBooking's summary above
        // is the curator-facing surface.
        allow read: if isMember(profileId) || isAdmin();
        allow write: if false; // Cloud Functions only
      }
    }

    // ---------- Sub-project 3: gigs, series, curator admin notes ----------
    match /gigs/{gigId} {
      // Only callables write, and only approved curator profiles can post;
      // profile unpublish cascades close open gigs (review.ts), so a bare
      // status check is sufficient, no per-read profile get().
      // List queries MUST pin status to one provable value, 'open',
      // 'filled', or 'closed' with bookedMusicianProfileId also constrained
      // (see the SP4 note below), an unfiltered or status-unconstrained
      // list fails.
      // Member/admin disjuncts are also list-provable as written: a curator
      // dashboard query filtered by where('curatorProfileId','==',X) pins
      // that field to a query-wide constant, so isMember(X) evaluates once
      // (not per document), if true, that disjunct alone proves the whole
      // OR for every possible result, regardless of each doc's actual
      // (unconstrained) status. isAdmin() never depends on resource.data,
      // so it's provable for any query, filtered or not.
      // SP4: 'filled' also reads publicly (a booking landed but the gig's
      // still upcoming), and so does 'closed' once bookedMusicianProfileId
      // is set (the gig happened, booked), both feed the Shows section
      // (gigs where('bookedMusicianProfileId','==',profileId), status in
      // ["filled","closed"]). status=='filled' alone is list-provable the
      // same way status=='open' is; the closed+booked disjunct ANDs in a
      // second resource.data field, so it's only provable for a query that
      // also constrains bookedMusicianProfileId, a bare status=='closed'
      // filter (bookedMusicianProfileId unconstrained) still can't prove it,
      // and a single closed-but-unbooked gig get() still denies.
      allow read: if resource.data.status == 'open' || resource.data.status == 'filled'
        || (resource.data.status == 'closed' && resource.data.bookedMusicianProfileId != null)
        || isMember(resource.data.curatorProfileId) || isAdmin();
      allow write: if false;
      match /private/location {
        // SP4 (spec §6, the SP3-promised reveal): the booked musician's
        // members also gain read access once bookedMusicianProfileId names
        // them, alongside the curator side. All three get() calls below hit
        // the same gigs/{gigId} doc, which Firestore rules cache within a
        // single evaluation, so this doesn't triple the read cost.
        allow read: if isAdmin()
          || isMember(get(/databases/$(database)/documents/gigs/$(gigId)).data.curatorProfileId)
          || (get(/databases/$(database)/documents/gigs/$(gigId)).data.bookedMusicianProfileId != null
              && isMember(get(/databases/$(database)/documents/gigs/$(gigId)).data.bookedMusicianProfileId));
        allow write: if false;
      }
    }
    match /gigSeries/{seriesId} {
      // Same list-provability shape as gigs above; series has no public
      // disjunct (never publicly listed), so an unfiltered or stranger list
      // always fails, only a curatorProfileId-filtered member query or an
      // admin's (filtered or not) query is provable.
      allow read: if isAdmin() || isMember(resource.data.curatorProfileId);
      allow write: if false;
    }

    // ---------- Sub-project 4: booking flow ----------
    match /bookings/{bookingId} {
      // Top-level (not nested under either profile), a booking belongs to
      // BOTH a curator and a musician profile, so read access is either
      // side's membership. All mutation goes through callables (bookings.ts
      // / bookingLifecycle.ts), never a direct client write.
      // NOT list-provable on a bare where('gigId','==',X): curatorProfileId
      // is unconstrained by that filter alone, so isMember(resource.data.
      // curatorProfileId) can't be evaluated as a single query-wide constant
      // per doc, the (gigId,status) index below serves callables/Admin SDK
      // only. A client "applicants for this gig" list must also pin
      // curatorProfileId == <own profile> for the member disjunct to prove.
      allow read: if isMember(resource.data.curatorProfileId)
        || isMember(resource.data.musicianProfileId) || isAdmin();
      allow write: if false;
    }

    // ---------- Sub-project 5: payments ----------
    match /bookings/{bookingId}/payments/{gigId} {
      // Same audience as the parent booking: either side's members + admins.
      // The parent get()s pin to the bookingId path segment, so a list query
      // scoped under one booking is provable for members of either side.
      // signedIn() guard (branch audit): short-circuits BEFORE the billed parent
      // get()s so an anonymous caller does not pay a document read to be denied,
      // matches the private/curatorBooking read rule's `signedIn() && exists()`
      // idiom above. isMember() already re-checks signedIn(), so this only moves
      // the cost, never the outcome.
      allow read: if isAdmin()
        || (signedIn() && (
          isMember(get(/databases/$(database)/documents/bookings/$(bookingId)).data.curatorProfileId)
          || isMember(get(/databases/$(database)/documents/bookings/$(bookingId)).data.musicianProfileId)));
      allow write: if false; // Cloud Functions only
    }
    // Webhook idempotency + append-only money audit, server/admin surfaces.
    match /stripeEvents/{eventId} { allow read: if isAdmin(); allow write: if false; }
    match /ledger/{entryId}       { allow read: if isAdmin(); allow write: if false; }
    // FakeStripe state (emulator only; the collection simply never exists in
    // production), never client-visible either way.
    match /stripeFake/{doc=**}    { allow read, write: if false; }

    // SP5 Task 9: the payments sweep's durable escalation queue, the money
    // states it deliberately refuses to act on and can only hand to a human
    // (see AdminAlertDoc). Admin-read, server-write, exactly like ledger and
    // stripeEvents above; releaseStuckSaga is the callable that resolves a row.
    match /adminAlerts/{alertId} { allow read: if isAdmin(); allow write: if false; }

    match /adminNotes/{uid} { allow read: if isAdmin(); allow write: if false; }
    match /curatorAccess/{uid} { allow read: if isOwner(uid) || isAdmin(); allow write: if false; }
    // S2: per-uid daily geocode call counter (functions/src/geocode.ts's
    // consumeGeocodeBudget), internal rate-limit bookkeeping only, never
    // read by any client (not even the owner) and never client-written.
    match /geocodeBudgets/{uid} { allow read, write: if false; }
    // S4: uids whose curatorAccess recompute failed at its original
    // touchpoint (review.ts's reject-from-approved cascade), queued for the
    // daily sweep's retry step (functions/src/scheduled.ts) to retry,
    // internal bookkeeping only, same as geocodeBudgets above.
    match /curatorAccessRetries/{uid} { allow read, write: if false; }

    // ---------- Sub-project 6: events & ticketing ----------
    // All writes across this section are Cloud Functions only (event
    // creation/publish, order/ticket minting, check-in, refunds, and the
    // transfer saga): no client create/update/delete anywhere below, not
    // even for a curator-side member or an admin.
    match /events/{eventId} {
      // Public once published, and stays visible after the event completes
      // (past-event pages); curator-side members preview their own
      // draft/cancelled events; admin sees all.
      allow read: if resource.data.status == 'published' || resource.data.status == 'completed'
        || isMember(resource.data.curatorProfileId) || isAdmin();
      allow write: if false; // Cloud Functions only

      match /tiers/{tierId} {
        // Same audience as the parent event, but a tier doc carries neither
        // status nor curatorProfileId itself, so it's proven via a get() on
        // the parent, same idiom as gigs/private/location above.
        allow read: if get(/databases/$(database)/documents/events/$(eventId)).data.status in ['published', 'completed']
          || isMember(get(/databases/$(database)/documents/events/$(eventId)).data.curatorProfileId) || isAdmin();
        allow write: if false;
      }

      match /private/address {
        // The door address: admin, curator-side members, or a signed-in
        // caller holding a valid ticket for THIS event. Rules cannot query
        // "any ticket for this event" directly, so the server maintains
        // users/{uid}/ticketIndex/{eventId} = { count } wherever tickets are
        // minted/refunded/transferred (Tasks 5, 6, 8); exists() on that doc
        // is the valid-ticket proof. signedIn() ordered first in that
        // disjunct: an anon caller's request.auth.uid is null, which throws
        // building the exists() path rather than absorbing into `false`,
        // same idiom as private/curatorBooking above.
        allow read: if isAdmin()
          || isMember(get(/databases/$(database)/documents/events/$(eventId)).data.curatorProfileId)
          || (signedIn()
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/ticketIndex/$(eventId)));
        allow write: if false;
      }

      match /attendees/{ticketId} {
        // The door list / check-in roster: curator-side members and admin
        // only. Never the attendee themselves via ownerUid: their own
        // ticket is read via users/{uid}/tickets/{ticketId} below.
        allow read: if isMember(get(/databases/$(database)/documents/events/$(eventId)).data.curatorProfileId) || isAdmin();
        allow write: if false;
      }
    }

    match /orders/{orderId} {
      // The buyer, curator-side members of the event's curator profile
      // (the order's own curatorProfileId, not a parent get(): orders are
      // top-level and self-declared, server-written), or admin.
      allow read: if signedIn()
        && (resource.data.buyerUid == request.auth.uid || isMember(resource.data.curatorProfileId) || isAdmin());
      allow write: if false; // Cloud Functions only
    }

    match /users/{uid}/tickets/{ticketId} {
      allow read: if isOwner(uid);
      allow write: if false; // Cloud Functions only
    }

    // The address gate's valid-ticket proof doc (TicketIndexDoc), owner-read
    // only. The whole point of exists()-checking it from another uid's
    // request in the private/address rule above is that it stays opaque to
    // everyone except its own owner (and the server that maintains it).
    match /users/{uid}/ticketIndex/{eventId} {
      allow read: if isOwner(uid);
      allow write: if false; // Cloud Functions only
    }

    match /transfers/{transferId} {
      // Visible to both parties of the transfer, or admin, never the
      // event's curator (transfers are a buyer-to-buyer handoff, no curator
      // stake in who holds which ticket).
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow write: if false; // Cloud Functions only
    }

    // ---------- Sub-project 7: fan discovery ----------
    // follows/{uid}_{targetId}: owner-read only (get + list pinned on uid),
    // callable-only writes (followTarget/unfollowTarget). The doc's own
    // uid field is the truth for list queries; the id is a convenience.
    match /follows/{followId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }

    // events/{eventId}/posts/{postId}: a musician's show note. Public when
    // the parent event is public AND the post is live; the event's curator
    // members, the author profile's members, and admin see all (removed
    // posts stay for moderation history). Callable-only writes.
    match /events/{eventId}/posts/{postId} {
      allow read: if isAdmin()
        || (resource.data.status == 'live'
            && get(/databases/$(database)/documents/events/$(eventId)).data.status in ['published', 'completed'])
        || isMember(get(/databases/$(database)/documents/events/$(eventId)).data.curatorProfileId)
        || isMember(resource.data.musicianProfileId);
      allow write: if false; // Cloud Functions only
    }

    // Recursive-wildcard match needed for collectionGroup('members') queries,
    // the nested /profiles/{profileId}/members/{memberUid} rule above does NOT
    // apply to collection-group queries. Mirrors the self-read clause so the
    // app's "my profiles" query (collectionGroup('members').where('uid','==',uid))
    // works for signed-in users reading their own membership docs. Also grants
    // admins the same collection-group access the nested rule's get already
    // gives them, so the admin dashboard's per-user "profiles and statuses"
    // lookup (collectionGroup('members').where('uid','==', targetUid)) works.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // Admin review queue: collectionGroup('tracks').where('status','==','pending_review').
    // The nested tracks rule above does not apply to collection-group queries.
    match /{path=**}/tracks/{trackId} {
      allow read: if isAdmin();
    }

    match /invites/{inviteId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.invitedUid
            || request.auth.uid == resource.data.invitedByUid);
      allow write: if false; // Cloud Functions only
    }

    // Listing this collection would dump every handle (including
    // draft/rejected profiles' handles) to any unauthenticated caller; a
    // single get() by known handle (the public profile page's lookup path)
    // stays world-readable.
    match /handles/{handle}   { allow get: if true; allow list: if false; allow write: if false; }
    match /auditLogs/{logId}  { allow read: if isAdmin(); allow write: if false; }
    match /{document=**}      { allow read, write: if false; }
  }
}
